<https://example.org/utas-research/supervisor/associate-professor-jenna-ziebell-9d1597a9e555> a utas:Supervisor ;
    rdfs:label "Associate Professor Jenna Ziebell"@en ;
    utas:affiliatedWith <https://example.org/utas-research/school/wicking-dementia-research-education-centre-5a346e82b5b2> ;
    utas:bio "Dr Jenna Ziebell is an Associate Professor in the Wicking Dementia Research and Education Centre. Her research interests include the role of microglia (the brain's immune cells) in health, ageing and disease; understanding traumatic brain injury and health education. Dr Ziebell has a strong interest in how the brain's immune system is altered, or primed, with ageing or injury and how this may lead to neurological diseases such as dementia.Dr Ziebell has a long-standing interest in the role of inflammation in neurological diseases, particularly the role of microglia. She is a mid-career researcher who established the Microglia and Neurological Diseases Laboratory at the University of Tasmania. Prior to this Jenna co-established the Translational Neurotrauma Program in Phoenix, AZ, USA; where she led a research team that investigated the role of microglia in acute neurological diseases. Her interest in the role of microglia in health and disease was ignited during her PhD at Monash University and has continued throughout postdoctoral research at the University of Adelaide (2009-2011), University of Kentucky (2012), USA, and University of Arizona/Phoenix Children’s Hospital (2012-2015). Dr Ziebell’s areas of interest include microglial activation in health and disease, trauma and injury related circuitry rearrangements, microglial priming and senescence in ageing and dementia; and more recently the social impact of intimate partner violence."^^xsd:string ;
    utas:canonicalName "Associate Professor Jenna Ziebell"^^xsd:string ;
    utas:discoveryProfileId "Jenna.Ziebell"^^xsd:string ;
    utas:discoveryProfileUrl "https://discover.utas.edu.au/api/users/Jenna.Ziebell"^^xsd:string ;
    utas:email "Jenna.Ziebell@utas.edu.au"^^xsd:string ;
    utas:hasResearchField <https://example.org/utas-research/research_field/biomedical-and-clinical-sciences-dd47e129275f>,
        <https://example.org/utas-research/research_field/cellular-nervous-system-abcec9e7fcbf>,
        <https://example.org/utas-research/research_field/central-nervous-system-6f4820d52c73>,
        <https://example.org/utas-research/research_field/neurology-and-neuromuscular-diseases-fcca8c03e8a4>,
        <https://example.org/utas-research/research_field/neurosciences-658af4d53a9d> ;
    utas:orcid "0000-0003-2497-4347"^^xsd:string ;
    utas:researchFieldsText "Central nervous system; Neurology and neuromuscular diseases; Cellular nervous system; Neurosciences; Biomedical and clinical sciences"^^xsd:string ;
