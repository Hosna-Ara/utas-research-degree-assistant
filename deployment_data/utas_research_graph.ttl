        <https://example.org/utas-research/research_category/marine-and-antarctic-35f1199e161e> ;
    utas:locatedAt <https://example.org/utas-research/location/hobart-ced14a7b4f5a> ;
    utas:projectId "12376"^^xsd:string ;
    utas:scholarshipText "$34,315 pa"^^xsd:string ;
    utas:sourceUrl "https://www.utas.edu.au/research/degrees/available-projects?id=12376"^^xsd:anyURI ;
    utas:supervisedBy <https://example.org/utas-research/supervisor/associate-professor-taryn-noble-b58b73e8c54c> ;
    utas:title "Dissolved trace metal sources and fluxes along the East Antarctic margin"^^xsd:string .

