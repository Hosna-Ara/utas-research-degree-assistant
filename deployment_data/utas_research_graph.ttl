        <https://example.org/utas-research/research_field/biological-sciences-4ef09db1f95d>,
        <https://example.org/utas-research/research_field/epigenetics-incl-genome-methylation-and-epigenomics-7873caf79738>,
        <https://example.org/utas-research/research_field/genetics-3b096ab7467a>,
        <https://example.org/utas-research/research_field/genome-structure-and-regulation-04549f9c3527>,
        <https://example.org/utas-research/research_field/neurogenetics-fa9f5046c82a> ;
    utas:orcid "0000-0002-5298-8730"^^xsd:string ;
    utas:researchFieldsText "Epigenetics (incl. genome methylation and epigenomics); Genome structure and regulation; Bioinformatic methods development; Neurogenetics; Genetics; Biological sciences; Bioinformatics and computational biology"^^xsd:string ;
    utas:school "University of Tasmania"^^xsd:string ;
