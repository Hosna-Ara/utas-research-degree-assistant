<https://example.org/utas-research/supervisor/associate-professor-alan-henderson-3d34661cf821> a utas:Supervisor ;
    rdfs:label "Associate Professor Alan Henderson"@en ;
    utas:affiliatedWith <https://example.org/utas-research/school/school-of-engineering-757090ead0c4> ;
    utas:bio "Alan Henderson is a Chartered Mechanical Engineer and Associate Professor in the School of Engineering at the University of Tasmania. He has a strong interest and proven track record in industry-collaborative research, addressing real-world engineering challenges across the aerospace, aquaculture, and renewable energy sectors. Alan has worked as a Chief Investigator on several Australian Research Council (ARC) projects, and led interdisciplinary efforts to deliver impactful outcomes for both industry and academia. Alan leads a research project investigating the hydraulics of dam spillways and pumped storage hydropower inlets with industry partner Hydro Tasmania. Alan is the Lead Engineering CI in the ARC Hub for Sustainable Onshore Lobster Aquaculture (SOLA). This project aims to develop a world-first commercial onshore lobster aquaculture industry. Alan is an enthusiastic educator with interests in the scholarship of university learning and teaching. He has worked as an investigator on several Office of Learning and Teaching national projects."^^xsd:string ;
    utas:canonicalName "Associate Professor Alan Henderson"^^xsd:string ;
    utas:discoveryProfileId "Alan.Henderson"^^xsd:string ;
    utas:discoveryProfileUrl "https://discover.utas.edu.au/api/users/Alan.Henderson"^^xsd:string ;
    utas:email "Alan.Henderson@utas.edu.au"^^xsd:string ;
