        <https://example.org/utas-research/research_field/inorganic-chemistry-5a940e9def83>,
        <https://example.org/utas-research/research_field/organometallic-chemistry-0260146c43b8>,
        <https://example.org/utas-research/research_field/transition-metal-chemistry-4e98b1991850> ;
    utas:orcid "0000-0002-7555-0635"^^xsd:string ;
    utas:researchFieldsText "Organometallic chemistry; Transition metal chemistry; Inorganic chemistry; Chemical sciences"^^xsd:string ;
