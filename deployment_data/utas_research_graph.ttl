        <https://example.org/utas-research/research_field/neurogenetics-fa9f5046c82a>,
        <https://example.org/utas-research/research_field/statistical-and-quantitative-genetics-1dd20308b8de> ;
    utas:orcid "0000-0002-9774-1539"^^xsd:string ;
    utas:researchFieldsText "Statistical and quantitative genetics; Genomics and transcriptomics; Neurogenetics; Bioinformatics and computational biology; Biological sciences; Genetics"^^xsd:string ;
