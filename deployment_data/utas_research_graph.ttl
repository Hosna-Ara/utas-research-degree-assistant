    utas:hasDegreeType <https://example.org/utas-research/degree_type/phd-0c2db2d9c990> ;
    utas:hasFundingStatus <https://example.org/utas-research/funding_status/funded-f40b10b9cf22> ;
    utas:hasResearchCategory <https://example.org/utas-research/research_category/physics-742b27454919> ;
    utas:locatedAt <https://example.org/utas-research/location/hobart-ced14a7b4f5a> ;
    utas:projectId "12129"^^xsd:string ;
    utas:scholarshipText "$34,315 pa"^^xsd:string ;
    utas:sourceUrl "https://www.utas.edu.au/research/degrees/available-projects?id=12129"^^xsd:anyURI ;
    utas:supervisedBy <https://example.org/utas-research/supervisor/professor-stas-shabala-99c660c241c4> ;
    utas:title "Black hole jets and star formation"^^xsd:string .

