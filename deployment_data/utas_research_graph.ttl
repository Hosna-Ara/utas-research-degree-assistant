<https://example.org/utas-research/supervisor/doctor-hoang-nguyen-8a6814e00c7e> a utas:Supervisor ;
    rdfs:label "Doctor Hoang Nguyen"@en ;
    utas:affiliatedWith <https://example.org/utas-research/school/wicking-dementia-research-education-centre-5a346e82b5b2> ;
    utas:bio "Dr Hoang Nguyen is a Lecturer at the Wicking Dementia Research and Education Centre, University of Tasmania, with over ten years of experience in teaching and research. She has expertise in qualitative and quantitative methodologies, program evaluation, and research tool validation. Her research interests include aged and dementia care, higher education curriculum and pedagogy, and rural and community health. She is particularly committed to enhancing the quality of life for people living with dementia, their families, and carers, especially by promoting dementia literacy, fostering effective communication, and supporting meaningful activities."^^xsd:string ;
