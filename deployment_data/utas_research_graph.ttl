        <https://example.org/utas-research/student_type/international-1e3bb894756f> ;
    utas:closingDate "1 October 2026"^^xsd:string ;
    utas:description "What are the sources and control on the supply of biologically essential trace metals on the East Antarctic margin? Using newly collected, co-located water-column, porewater and DNA samples from multiple regions in East Antarctica, this project will quantify the source of metal fluxes to test how seafloor sediments, glaciogenic inputs, water masses and microbial communities regulate dissolved iron and other trace metals."^^xsd:string ;
    utas:hasApplicationStatus <https://example.org/utas-research/application_status/applications-open-96babda2cbca> ;
    utas:hasDegreeType <https://example.org/utas-research/degree_type/phd-0c2db2d9c990> ;
