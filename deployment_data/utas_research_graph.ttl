<https://example.org/utas-research/supervisor/associate-professor-jacqueline-halpin-39f9f95790f9> a utas:Supervisor ;
    rdfs:label "Associate Professor Jacqueline Halpin"@en ;
    utas:affiliatedWith <https://example.org/utas-research/school/institute-for-marine-and-antarctic-studies-bd99c2807811> ;
    utas:bio "Dr Jacqueline Halpin is geologist and Associate Professor at the Institute for Marine and Antarctic Studies (IMAS). Her research mainly examines dynamic processes occurring in the Earth's crust, including: crustal growth and architecture; continental rifting, breakup and exhumation; and tectonic cycles and supercontinent configurations. Jacqueline is currently working on Antarctic geoscience themes including past ice sheet change and Earth-cryosphere interactions, as part of the ARC Australian Centre for Excellence in Antarctic Science Special Research Initiative (ACEAS).Jacqueline joined IMAS in 2015. She completed her science undergraduate degree with Honours in Geology from the University of Melbourne in 2001, and was awarded her PhD, on the tectonic evolution of the Rayner Complex in East Antarctica, from the University of Sydney in 2007. She has also worked for the Centre of Ore Deposit and Earth Sciences (CODES) as a research fellow and at Macquarie University (2007-2015) and University of Sydney (2011-2012) as a lecturer and research associate."^^xsd:string ;
    utas:canonicalName "Associate Professor Jacqueline Halpin"^^xsd:string ;
