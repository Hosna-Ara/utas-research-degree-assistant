    utas:projectId "12209"^^xsd:string ;
    utas:scholarshipText "$34,315 pa"^^xsd:string ;
    utas:sourceUrl "https://www.utas.edu.au/research/degrees/available-projects?id=12209"^^xsd:anyURI ;
    utas:supervisedBy <https://example.org/utas-research/supervisor/doctor-james-venning-33d27a06a0b9> ;
    utas:title "Fluid-structure interactions of non-cavitating and cavitating lifting surfaces"^^xsd:string .

