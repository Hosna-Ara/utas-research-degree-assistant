        <https://example.org/utas-research/student_type/international-1e3bb894756f> ;
    utas:closingDate "1 October 2026"^^xsd:string ;
    utas:description "This research will partner with marine-linked communities in south-east Tasmania to examine socio-ecological and socio-cultural values, trial innovative frameworks such as social accounting and wellbeing, and propose an integrated assessment methodology for ecological monitoring and the analysis of community values."^^xsd:string ;
    utas:hasApplicationStatus <https://example.org/utas-research/application_status/applications-open-96babda2cbca> ;
    utas:hasDegreeType <https://example.org/utas-research/degree_type/phd-0c2db2d9c990> ;
    utas:hasFundingStatus <https://example.org/utas-research/funding_status/funded-f40b10b9cf22> ;
    utas:hasResearchCategory <https://example.org/utas-research/research_category/marine-and-antarctic-35f1199e161e> ;
    utas:locatedAt <https://example.org/utas-research/location/hobart-ced14a7b4f5a> ;
    utas:projectId "12123"^^xsd:string ;
    utas:scholarshipText "$34,315 pa"^^xsd:string ;
    utas:sourceUrl "https://www.utas.edu.au/research/degrees/available-projects?id=12123"^^xsd:anyURI ;
    utas:supervisedBy <https://example.org/utas-research/supervisor/associate-professor-emily-ogier-fb10a3a29f20> ;
    utas:title "Aligning marine ecological and social assessment of community values at regional scales"^^xsd:string .

<https://example.org/utas-research/project/12124> a utas:ResearchProject ;
    utas:acceptsStudentType <https://example.org/utas-research/student_type/domestic-bfb9e6d725a0>,
        <https://example.org/utas-research/student_type/international-1e3bb894756f> ;
    utas:closingDate "1 October 2026"^^xsd:string ;
    utas:description "This project uses machine learning and UTAS telescope data to create Tasmania’s first Dark Sky and Atmospheric Health Index, mapping light pollution, atmospheric change, and ecological vulnerability to protect the island’s night skies and environmental resilience."^^xsd:string ;
    utas:hasApplicationStatus <https://example.org/utas-research/application_status/applications-open-96babda2cbca> ;
