        <https://example.org/utas-research/research_field/philosophy-and-religious-studies-133312ea45fb> ;
    utas:orcid "0000-0002-4832-6611"^^xsd:string ;
    utas:researchFieldsText "Phenomenology; Philosophical psychology (incl. moral psychology and philosophy of action); History of ideas; Philosophy; Philosophy and religious studies; History and philosophy of specific fields"^^xsd:string ;
