<https://example.org/utas-research/supervisor/doctor-catherine-goetze-841c37476488> a utas:Supervisor ;
    rdfs:label "Doctor Catherine Goetze"@en ;
    utas:affiliatedWith <https://example.org/utas-research/school/school-of-social-sciences-8de08ca8c819> ;
    utas:bio "I am a Senior Lecturer in International Relations in the School of Social Sciences at the University of Tasmania. Prior to this, I was Senior Lecturer and Course Coordinator at the University of Sussex, and Associate Professor and Head of International Studies at the University of Nottingham Ningbo, China. I am author of the textbook 'World Politics. A Critical Introduction'. My academic trajectory has been shaped by a cosmopolitan background: I have studied and worked in five countries, across two continents, and in three languages. This lived experience informs my commitment to critical approaches in International Relations. My research and teaching are driven by the conviction that decolonising, indigenising, and feminising the discipline are not only matters of justice but also of intellectual integrity. I seek to challenge dominant narratives in order to generate new ways of understanding global politics and our place within it. In addition to my academic work, I maintain a broad range of interests, from kendo and kayaking to bushwalking and textile crafts, and I am also a mother of two."^^xsd:string ;
    utas:canonicalName "Doctor Catherine Goetze"^^xsd:string ;
    utas:discoveryProfileId "Catherine.Goetze"^^xsd:string ;
    utas:discoveryProfileUrl "https://discover.utas.edu.au/api/users/Catherine.Goetze"^^xsd:string ;
    utas:email "Catherine.Goetze@utas.edu.au"^^xsd:string ;
    utas:hasResearchField <https://example.org/utas-research/research_field/gender-studies-310ec20f9d0c>,
        <https://example.org/utas-research/research_field/historical-studies-73b4333db4c6>,
