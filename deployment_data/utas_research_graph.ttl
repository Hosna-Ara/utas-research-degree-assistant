        <https://example.org/utas-research/research_field/human-society-4632b664cb39>,
        <https://example.org/utas-research/research_field/international-history-b42f4bf1549f>,
        <https://example.org/utas-research/research_field/international-relations-cacb19fb0dcb>,
        <https://example.org/utas-research/research_field/political-science-9bebebc27bda> ;
    utas:orcid "0000-0001-5027-7874"^^xsd:string ;
    utas:researchFieldsText "International relations; Gender studies; International history; Political science; Human society; Historical studies; History, heritage and archaeology"^^xsd:string ;
