<https://example.org/utas-research/supervisor/associate-professor-nicole-hill-e9695aafd000> a utas:Supervisor ;
    rdfs:label "Associate Professor Nicole Hill"@en ;
    utas:affiliatedWith <https://example.org/utas-research/school/institute-for-marine-and-antarctic-studies-bd99c2807811> ;
    utas:bio "Dr Nicole Hill a quantitative marine ecologist who leads a team of researchers focussing on mapping and predicting marine biodiversity. Dr Hill's team uses the latest techniques at the interface of ecology and statistics and her research has impact in the areas of conservation, spatial planning, fisheries, ecosystem assessment and the development of monitoring programs. A key component of her team's current research focusses understanding and mapping the current distribution of benthic and demersal ecosystems in the Southern Ocean and predicting how they may change in response to climate change and other pressures.A selection of her team’s research includes; mapping the circumpolar distribution of benthic biodiversity, developing an integrative index for Vulnerable Marine Ecosystems (VME) from imagery, understanding how environmental variability affects Patagonian Toothfish catch rates, assessing methods to detect ecological change, quantifying recent change in demersal fish and zooplankton assemblages and using these outputs to help optimize monitoring."^^xsd:string ;
    utas:canonicalName "Associate Professor Nicole Hill"^^xsd:string ;
    utas:discoveryProfileId "Nicole.Hill"^^xsd:string ;
    utas:discoveryProfileUrl "https://discover.utas.edu.au/api/users/Nicole.Hill"^^xsd:string ;
    utas:email "Nicole.Hill@utas.edu.au"^^xsd:string ;
    utas:hasResearchField <https://example.org/utas-research/research_field/climate-change-impacts-and-adaptation-f83eec5688b6>,
        <https://example.org/utas-research/research_field/conservation-and-biodiversity-c4eb69f5ad84>,
        <https://example.org/utas-research/research_field/ecological-impacts-of-climate-change-and-ecological-adaptation-c047d07c3684>,
