    utas:hasResearchCategory <https://example.org/utas-research/research_category/physics-742b27454919> ;
    utas:locatedAt <https://example.org/utas-research/location/hobart-ced14a7b4f5a> ;
    utas:projectId "12124"^^xsd:string ;
    utas:scholarshipText "$34,315 pa"^^xsd:string ;
    utas:sourceUrl "https://www.utas.edu.au/research/degrees/available-projects?id=12124"^^xsd:anyURI ;
    utas:supervisedBy <https://example.org/utas-research/supervisor/doctor-karelle-siellez-4b4eeb29051f> ;
    utas:title "Intelligent Eco-Astronomy: Using Machine Learning and Astronomical Telescope Data to Map and Protect Tasmania’s Dark Skies and Atmospheric Health"^^xsd:string .

<https://example.org/utas-research/project/12125> a utas:ResearchProject ;
    utas:acceptsStudentType <https://example.org/utas-research/student_type/domestic-bfb9e6d725a0>,
        <https://example.org/utas-research/student_type/international-1e3bb894756f> ;
    utas:closingDate "1 October 2026"^^xsd:string ;
    utas:description "The Antarctic marginal ice zone (MIZ) is a dynamic, wave-influenced boundary which can influence sea-ice extent. This PhD develops machine-learning and satellite methods to map MIZ variability, link storms and waves to retreat, reveal ice properties, and improve validation."^^xsd:string ;
    utas:hasApplicationStatus <https://example.org/utas-research/application_status/applications-open-96babda2cbca> ;
    utas:hasDegreeType <https://example.org/utas-research/degree_type/phd-0c2db2d9c990> ;
    utas:hasFundingStatus <https://example.org/utas-research/funding_status/funded-f40b10b9cf22> ;
    utas:hasResearchCategory <https://example.org/utas-research/research_category/earth-sciences-32a57b471aa6>,
        <https://example.org/utas-research/research_category/marine-and-antarctic-35f1199e161e> ;
    utas:locatedAt <https://example.org/utas-research/location/hobart-ced14a7b4f5a> ;
    utas:projectId "12125"^^xsd:string ;
    utas:scholarshipText "$34,315 pa"^^xsd:string ;
    utas:sourceUrl "https://www.utas.edu.au/research/degrees/available-projects?id=12125"^^xsd:anyURI ;
    utas:supervisedBy <https://example.org/utas-research/supervisor/doctor-alex-fraser-8ceed58b4f0d> ;
    utas:title "Advancing Antarctic marginal ice zone knowledge with machine learning"^^xsd:string .

<https://example.org/utas-research/project/12129> a utas:ResearchProject ;
    utas:acceptsStudentType <https://example.org/utas-research/student_type/domestic-bfb9e6d725a0>,
        <https://example.org/utas-research/student_type/international-1e3bb894756f> ;
    utas:closingDate "1 October 2026"^^xsd:string ;
