        <https://example.org/utas-research/research_field/environmental-sciences-164cd82d67b0> ;
    utas:orcid "0000-0001-9329-6717"^^xsd:string ;
    utas:researchFieldsText "Ecological impacts of climate change and ecological adaptation; Conservation and biodiversity; Climate change impacts and adaptation; Environmental sciences; Environmental management"^^xsd:string ;
