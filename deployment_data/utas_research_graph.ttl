<https://example.org/utas-research/supervisor/doctor-david-green-2adc99b35b68> a utas:Supervisor ;
    rdfs:label "Doctor David Green"@en ;
    utas:bio "David is a marine spatial ecologist and Lecturer in Marine Spatial Ecology at IMAS (Institute for Marine and Antarctic Studies), University of Tasmania. With around 15 years of experience in biologging and animal tracking, he has worked across more than 15 marine predator species, spanning temperate, Subantarctic and Antarctic systems. His research combines biotelemetry, statistical and mechanistic modelling approaches to resolve links between the physical environment and ecological processes across multiple trophic levels, from oceanographic drivers through mid trophic prey dynamics to top predator foraging ecology. He holds a PhD from IMAS, a strong publication record built over more than a decade, and extensive field leadership experience, including coordinating tagging voyages and expeditions across remote and polar systems. His work increasingly bridges research and policy, contributing to international spatial conservation and management processes, alongside a growing teaching, supervision, and mentorship portfolio."^^xsd:string ;
    utas:canonicalName "Doctor David Green"^^xsd:string ;
    utas:discoveryProfileId "David.Green"^^xsd:string ;
    utas:discoveryProfileUrl "https://discover.utas.edu.au/api/users/David.Green"^^xsd:string ;
    utas:email "David.Green@utas.edu.au"^^xsd:string ;
    utas:hasResearchField <https://example.org/utas-research/research_field/biological-sciences-4ef09db1f95d>,
        <https://example.org/utas-research/research_field/community-ecology-excl-invasive-species-ecology-a914df5c7767>,
        <https://example.org/utas-research/research_field/ecology-8d45d1ea845e>,
        <https://example.org/utas-research/research_field/infectious-agents-e31aba7d4461>,
        <https://example.org/utas-research/research_field/marine-and-estuarine-ecology-incl-marine-ichthyology-c85dcd8a0371>,
        <https://example.org/utas-research/research_field/microbiology-fe2136cb18b3> ;
