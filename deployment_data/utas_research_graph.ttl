<https://example.org/utas-research/supervisor/doctor-karen-hall-00e9da335315> a utas:Supervisor ;
    rdfs:label "Doctor Karen Hall"@en ;
    utas:affiliatedWith <https://example.org/utas-research/school/school-of-creative-arts-and-media-4d8458d3c4de> ;
    utas:bio "Dr Karen Hall is a lecturer in art at the School of Creative and Performing Arts at the Inveresk campus. My research explores connections between past and present within the Tasmanian landscape, examining the interplay of cultural and environmental changes through her individual practice and collaborative projects. I reach in a range of areas, from art and performance theory and histories to the material and visual cultures of family history. I have led significant curriculum change and prioritise inclusion through my teaching. I completed my PhD at the University of Western Australia in 2008. Joining the then School of Visual and Performing Arts, I developed and delivered new units in art and performance history and theory. I am currently the Graduate Research Coordinator for the School of Creative and Performing Arts. I am highly involved in the local arts ecology. I am currently on the board of Assembly 197 and was Chair of Sawtooth ARI (2015-2016). These connections inform my commitment to place-based learning and research. I am the Tasmanian representative for the Art Association for Australia and New Zealand."^^xsd:string ;
    utas:canonicalName "Doctor Karen Hall"^^xsd:string ;
    utas:discoveryProfileId "Karen.Hall"^^xsd:string ;
    utas:discoveryProfileUrl "https://discover.utas.edu.au/api/users/Karen.Hall"^^xsd:string ;
    utas:email "Karen.Hall@utas.edu.au"^^xsd:string ;
    utas:hasResearchField <https://example.org/utas-research/research_field/art-history-theory-and-criticism-aa852f796901>,
        <https://example.org/utas-research/research_field/creative-arts-and-writing-62daf37a74cd> ;
    utas:orcid "0000-0001-7812-4810"^^xsd:string ;
    utas:researchFieldsText "Art history, theory and criticism; Creative arts and writing"^^xsd:string ;
    utas:school "School of Creative Arts and Media"^^xsd:string ;
    utas:supervises <https://example.org/utas-research/project/12142>,
