        <https://example.org/utas-research/research_field/language-communication-and-culture-2450a3a6e21a> ;
    utas:orcid "0000-0001-6093-8330"^^xsd:string ;
    utas:researchFieldsText "Environmental communication; Climate change impacts and adaptation; Communication and media studies; Language, communication and culture; Environmental sciences"^^xsd:string ;
    utas:school "University of Tasmania"^^xsd:string ;
