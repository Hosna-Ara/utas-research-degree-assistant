        <https://example.org/utas-research/research_field/pharmacology-and-pharmaceutical-sciences-9c5040292779> ;
    utas:researchFieldsText "Pharmaceutical sciences; Biochemistry and cell biology; Pharmacology and pharmaceutical sciences; Biomedical and clinical sciences; Biological sciences"^^xsd:string ;
