<https://example.org/utas-research/supervisor/doctor-curtis-ho-6308944c2a12> a utas:Supervisor ;
    rdfs:label "Doctor Curtis Ho"@en ;
    utas:affiliatedWith <https://example.org/utas-research/school/school-of-natural-sciences-7ce3a3316721> ;
    utas:bio "Originally born in Toronto, Canada, Curtis attended the University of Tasmania for his undergraduate and postgraduate studies. Upon graduating with his PhD (UTAS) in 2015, Curtis was appointed a Casual Lecturer in Chemistry in a teaching-intensive position. In this role, he taught at each level of the UTAS Chemistry program across foundation, first-, second- and third-year chemistry units, while making contributions to curriculum development and modernisation.Curtis was appointed as a Lecturer in Chemistry in 2020. In 2023, he was awarded a highly competitive and prestigious Australian Research Council Discovery Early Career Researcher Award (ARC DECRA) to establish his independent research program. In 2024, he was promoted to Senior Lecturer in Inorganic Chemistry. His research interests span areas of organometallic, inorganic, organic and structural chemistry (single crystal X-ray diffraction), and chemical catalysis.Curtis has a particular interest in developing highly reactive molecular catalysts to enable the efficient activation of small molecules such as H2, N2 and CO2."^^xsd:string ;
    utas:canonicalName "Doctor Curtis Ho"^^xsd:string ;
    utas:discoveryProfileId "Curtis.Ho"^^xsd:string ;
    utas:discoveryProfileUrl "https://discover.utas.edu.au/api/users/Curtis.Ho"^^xsd:string ;
