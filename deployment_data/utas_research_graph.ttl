<https://example.org/utas-research/supervisor/professor-kaylene-young-a4aa3db9ed5e> a utas:Supervisor ;
    rdfs:label "Professor Kaylene Young"@en ;
    utas:affiliatedWith <https://example.org/utas-research/school/menzies-institute-for-medical-research-12e6f452c508> ;
    utas:bio "Professor Kaylene Young received her Bachelor of Science (hons) degree from Monash University before undertaking her PhD at the Walter and Eliza Hall Institute (conferred by the University of Melbourne). In 2003, Kaylene assisted with the successful establishment of the Queensland Brain Institute at the University of Queensland before relocating in 2005 to undertake postdoctoral research at University College London. In 2012, Kaylene was recruited to head the Glial Research Team and was Theme Leader for Brain Health Research at the Menzies Institute for Medical Research until 2025. Kaylene now co-leads the University of Tasmania's Multiple Sclerosis Research Flagship and is academic lead for the NHMRC Centre of Excellence in Multiple Sclerosis Research Translation."^^xsd:string ;
