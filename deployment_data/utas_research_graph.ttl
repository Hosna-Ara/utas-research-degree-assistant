        <https://example.org/utas-research/research_field/urban-and-regional-planning-3991e8c38b60> ;
    utas:orcid "0000-0002-4393-8635"^^xsd:string ;
    utas:researchFieldsText "Conservation and biodiversity; Land use and environmental planning; Cultural heritage management (incl. world heritage); Physical geography and environmental geoscience; Environmental management; Environmental sciences; Urban and regional planning; Built environment and design; Heritage, archive and museum studies; History, heritage and archaeology; Earth sciences"^^xsd:string ;
