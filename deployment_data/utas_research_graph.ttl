<https://example.org/utas-research/supervisor/professor-verity-cleland-9c4fab8b3c03> a utas:Supervisor ;
    rdfs:label "Professor Verity Cleland"@en ;
    utas:affiliatedWith <https://example.org/utas-research/school/menzies-institute-for-medical-research-12e6f452c508> ;
    utas:bio "Professor Verity Cleland is a public health researcher, educator, and advisor with deep expertise in population health, health promotion, and applied research translation. Based at the University of Tasmania, she brings more than a decade of experience leading complex research projects, supervising postgraduate students, and working collaboratively with government, community organisations, and health services. Professor Cleland's research focuses on understanding how where we live, work, study, and play can impact physical activity, and on developing population level strategies to increase activity. Her work focuses on generating and applying evidence to improve health outcomes, particularly through rigorous research design, program evaluation, and the translation of findings into policy and practice. She works closely with partners from diverse disciplines to ensure her research is highly relevant to policy and practice. Verity is known for her ability to distil complex information into clear, actionable insights — a skill she applies in grant development, research capacity‑building, and advisory roles. She is an invited member of international, national, and local funding panels, peer reviews for many academic journals, and regularly examines PhD theses. She is widely recognised for her supportive, collaborative approach and her commitment to building research capability across the health and community sectors. She is Chair of the Tasmanian Premier’s Health and Wellbeing Advisory Council, where she advises the Premier on best practices approaches to improving health and wellbeing, and the Tasmanian Active Living Coalition, where she brings together professionals across academia, planning, local government, state government, advocacy, and transport to connect and advocate for environments that support active living. The impact of her work has been recognised through numerous awards, including a Paul Dudley White Scholar Award at the American Heart Association's Epi | Lifestyle scientific meeting (2019) and institutional Research Impact (2024), Academic Mentoring (2023), Engagement (2021), and Best Publication (2022) awards."^^xsd:string ;
    utas:canonicalName "Professor Verity Cleland"^^xsd:string ;
    utas:discoveryProfileId "Verity.Cleland"^^xsd:string ;
    utas:discoveryProfileUrl "https://discover.utas.edu.au/api/users/Verity.Cleland"^^xsd:string ;
    utas:email "Verity.Cleland@utas.edu.au"^^xsd:string ;
    utas:hasResearchField <https://example.org/utas-research/research_field/behavioural-epidemiology-ab2f3640ad49>,
        <https://example.org/utas-research/research_field/biomedical-and-clinical-sciences-dd47e129275f>,
        <https://example.org/utas-research/research_field/cardiology-incl-cardiovascular-diseases-e160644219c4>,
        <https://example.org/utas-research/research_field/cardiovascular-medicine-and-haematology-e884c1de32ea>,
        <https://example.org/utas-research/research_field/epidemiology-e13af74b412c>,
        <https://example.org/utas-research/research_field/health-promotion-0434f6d54ab0>,
        <https://example.org/utas-research/research_field/health-sciences-fd4489cbbcc8>,
        <https://example.org/utas-research/research_field/public-health-69f121230b69>,
        <https://example.org/utas-research/research_field/public-health-not-elsewhere-classified-ec78a246d4ed> ;
    utas:orcid "0000-0001-8358-3237"^^xsd:string ;
