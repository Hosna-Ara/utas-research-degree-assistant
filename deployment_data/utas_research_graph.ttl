    utas:orcid "0000-0002-2698-3207"^^xsd:string ;
    utas:researchFieldsText "LOTE, ESL and TESOL curriculum and pedagogy; English and literacy curriculum and pedagogy (excl. LOTE, ESL and TESOL); Curriculum and pedagogy; Education"^^xsd:string ;
    utas:school "Faculty of Education"^^xsd:string ;
