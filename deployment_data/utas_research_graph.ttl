        <https://example.org/utas-research/research_field/molecular-evolution-81759e8265f8>,
        <https://example.org/utas-research/research_field/phylogeny-and-comparative-analysis-10452f70b85f> ;
    utas:orcid "0000-0003-1940-0007"^^xsd:string ;
    utas:researchFieldsText "Genomics; Molecular evolution; Phylogeny and comparative analysis; Genetics; Biological sciences; Evolutionary biology"^^xsd:string ;
