        <https://example.org/utas-research/research_field/mechanical-engineering-cf1601609e88> ;
    utas:orcid "0000-0003-4293-7523"^^xsd:string ;
    utas:researchFieldsText "Fluid mechanics and thermal engineering; Fluid mechanics and thermal engineering not elsewhere classified; Energy generation, conversion and storage (excl. chemical and electrical); Electrical energy storage; Engineering; Mechanical engineering; Electrical engineering"^^xsd:string ;
